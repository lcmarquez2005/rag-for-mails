# ==============================================================================
# CONFIGURACIÓN GENERAL DEL MODELO DE IA
# ==============================================================================
# Proveedor activo por defecto: 'ollama', 'gemini', 'openai' o 'anthropic'
LLM_PROVIDER=ollama

# (Opcional) Sobrescribir modelo global; si se deja vacío, cada proveedor usa su modelo exacto configurado abajo
# LLM_MODEL=

# Temperatura para generación determinista (0.0 recomendado para extracción estricta)
LLM_TEMPERATURE=0.0


# ==============================================================================
# 1. OLLAMA (Servidor Local - PREDETERMINADO)
# ==============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b


# ==============================================================================
# 2. GOOGLE GEMINI (Gemini Pro / Flash)
# ==============================================================================
# Obtén tu API Key gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro


# ==============================================================================
# 3. OPENAI
# ==============================================================================
# Obtén tu API Key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1


# ==============================================================================
# 4. ANTHROPIC CLAUDE
# ==============================================================================
# Obtén tu API Key en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620


# ==============================================================================
# 5. INTEGRACIÓN GMAIL API & WEBHOOKS
# ==============================================================================
# Remitente(s) autorizados para procesar reportes por correo (separados por coma si son varios)
GMAIL_AUTHORIZED_SENDER=l23200286@pachuca.tecnm.mx


# ==============================================================================
# 6. SERVIDOR FASTAPI
# ==============================================================================
API_HOST=0.0.0.0
API_PORT=8000
